{
  "name": "what-the-duck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A yellow duck endless runner for BUSY Bar.",
  "scripts": {
    "build": "busy-cli build",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app:install": "node --env-file-if-exists=.env scripts/install.mjs",
    "app:run": "node --env-file-if-exists=.env scripts/install.mjs --launch-only",
    "preview": "node scripts/preview.mjs",
    "generate": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@busy-app/cli": "^0.6.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vite": "^8.1.6"
  },
  "license": "MIT"
}
